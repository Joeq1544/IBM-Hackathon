# IBM Cloud auth
IBM_API_KEY=your_ibm_api_key_here

# watsonx Orchestrate — get Agent ID from Orchestrate console after creating Manager Agent
ORCHESTRATE_BASE_URL=https://api.ibm.com/watsonx-orchestrate/run/v1
ORCHESTRATE_MANAGER_AGENT_ID=your_manager_agent_id_here

# watsonx.ai (for direct Granite model calls if needed)
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
